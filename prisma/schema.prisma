// Domain model: docs/DOMAIN.md. Terms: GLOSSARY.md.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model ClubSettings {
  id               Int      @id @default(1) // singleton row
  name             String
  location         String
  description      String
  defaultOpenTime  String   @default("12:00") // "HH:mm", club timezone; prefills activated days
  defaultCloseTime String   @default("20:00") // "HH:mm" or "24:00"
  updatedAt        DateTime @updatedAt
}

// A date the club may be booked on. No row, or isActive = false, means inactive.
// Deactivating keeps the hours so re-activating restores them. See docs/adr/0002.
model ClubDay {
  date      DateTime @id @db.Date // club-local calendar date
  isActive  Boolean  @default(true)
  openTime  String // "HH:mm", club timezone
  closeTime String // "HH:mm" or "24:00"; never past midnight
  updatedAt DateTime @updatedAt
}

model Table {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  bookings    Booking[]
}

model Booking {
  id           String        @id @default(uuid())
  tableId      String
  startsAt     DateTime // UTC
  endsAt       DateTime // UTC
  note         String?
  status       BookingStatus
  adminComment String? // visible to the booker and admins

  // Exactly one of: member booking (userId) or walk-in booking (walkInName).
  // Enforced by a CHECK constraint in the init migration.
  userId        String?
  walkInName    String? // admins only
  walkInContact String? // admins only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User? @relation(fields: [userId], references: [id])
  table Table @relation(fields: [tableId], references: [id])

  @@index([tableId, startsAt])
  @@index([startsAt])
  @@index([userId])
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique // identity; sign-in key; never changes
  username   String    @unique // shown on the day view; unique ignoring case (checked in the app)
  fullName   String?
  phone      String?
  telegram   String? // without the leading @
  adminNotes String? // admins only
  image      String?
  role       Role      @default(MEMBER)
  createdAt  DateTime  @default(now())
  bookings   Booking[]
}

enum Role {
  MEMBER
  ADMIN
}

// Completed and Expired are derived from time, not stored: docs/adr/0001
enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
