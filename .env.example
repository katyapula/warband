# Comma-separated emails that get the Admin role at sign-in
ADMIN_EMAILS=

# Club rules (defaults shown)
CLUB_TIMEZONE=Europe/Kyiv
BOOKING_WINDOW_DAYS=30
SLOT_STEP_MINUTES=30
MIN_BOOKING_MINUTES=60
