# Database (Neon). Local dev and Vercel previews use the Neon `dev` branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth (NextAuth + Google)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
